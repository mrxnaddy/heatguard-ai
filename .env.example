# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- FortyGuard ---
# Leave FORTYGUARD_API_KEY unset while USE_MOCK_DATA=true.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.example/v1
USE_MOCK_DATA=true

# --- LLM (config wired in Phase 2; used starting Phase 3) ---
LLM_API_KEY=
LLM_MODEL=not-configured

# --- Cache ---
CACHE_TTL_SECONDS=300
